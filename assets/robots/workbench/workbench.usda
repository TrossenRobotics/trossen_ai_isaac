        {
            float drive:linear:physics:damping = 50
            float drive:linear:physics:maxForce = 400
            float drive:linear:physics:stiffness = 1000
            uniform token drive:linear:physics:type = "force"
        }

        over "follower_right_right_carriage_joint" (
            prepend apiSchemas = ["PhysicsDriveAPI:linear"]
        )
        {
            float drive:linear:physics:damping = 50
            float drive:linear:physics:maxForce = 400
            float drive:linear:physics:stiffness = 1000
            uniform token drive:linear:physics:type = "force"
        }
    }
}

def PhysicsScene "PhysicsScene" (
    prepend apiSchemas = ["NewtonSceneAPI", "PhysxSceneAPI"]
    prepend payload = @./Payload/Contents.usda@</PhysicsScene>
)
{
    uint physxScene:gpuFoundLostAggregatePairsCapacity = 2048
}
